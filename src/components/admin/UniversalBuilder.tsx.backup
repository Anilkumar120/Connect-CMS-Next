};

const KIND_LABELS: Record<BuilderKind, string> = {
  header: "Header",
  footer: "Footer",
  page: "Page",
  post: "Post",
  single: "Single Template",
  archive: "Archive Template",
  custom: "Custom Post Type",
};

const LAYOUT_TYPES = new Set(["section", "container"]);

const UNITS = ["px", "%", "rem", "em", "vw", "vh", "auto"];

const makeId = (type: string) =>
  `${type}-${Date.now().toString(36)}-${Math.random()
    .toString(36)
    .slice(2, 8)}`;

function cloneNode(node: BuilderNode): BuilderNode {
  return {
    ...node,
    id: makeId(node.type),
    props: structuredClone(node.props || {}),
    styles: structuredClone(node.styles),
    advanced: node.advanced ? structuredClone(node.advanced) : undefined,
    children: (node.children || []).map(cloneNode),
  };
}

function findNode(nodes: BuilderNode[], id: string | null): BuilderNode | null {
  if (!id) return null;

  for (const node of nodes) {
    if (node.id === id) return node;

    const found = findNode(node.children || [], id);

    if (found) return found;
  }

  return null;
}

function findParent(
  nodes: BuilderNode[],
  id: string,
  parentId: string | null = null,
): string | null | undefined {
  for (const node of nodes) {
    if (node.id === id) return parentId;

    const result = findParent(node.children || [], id, node.id);

    if (result !== undefined) return result;
  }

  return undefined;
}

function updateTree(
  nodes: BuilderNode[],
  id: string,
  updater: (node: BuilderNode) => BuilderNode,
): BuilderNode[] {
  return nodes.map((node) => {
    if (node.id === id) return updater(node);

    return {
      ...node,
      children: updateTree(node.children || [], id, updater),
    };
  });
}

function removeTree(
  nodes: BuilderNode[],
  id: string,
): {
  nodes: BuilderNode[];
  removed: BuilderNode | null;
} {
  const index = nodes.findIndex((node) => node.id === id);

  if (index !== -1) {
    const next = [...nodes];
    const [removed] = next.splice(index, 1);

    return { nodes: next, removed };
  }

  let removed: BuilderNode | null = null;

  const next = nodes.map((node) => {
    const result = removeTree(node.children || [], id);

    if (result.removed) {
      removed = result.removed;

      return {
        ...node,
        children: result.nodes,
      };
    }

    return node;
  });

  return { nodes: next, removed };
}

function insertTree(
  nodes: BuilderNode[],
  parentId: string | null,
  node: BuilderNode,
): BuilderNode[] {
  if (!parentId) return [...nodes, node];

  return nodes.map((item) => {
    if (item.id === parentId) {
      return {
        ...item,
        children: [...(item.children || []), node],
      };
    }

    return {
      ...item,
      children: insertTree(item.children || [], parentId, node),
    };
  });
}

function moveNode(
  root: BuilderNode[],
  activeId: string,
  overId: string,
  parentId: string | null,
): BuilderNode[] {
  const activeNode = findNode(root, activeId);

  if (!activeNode || activeId === overId) return root;

  const descendants = getAllNodeIds([activeNode]);

  if (parentId && descendants.includes(parentId)) {
    return root;
  }

  const sourceParent = findParent(root, activeId);

  if (sourceParent === undefined) return root;

  const removed = removeTree(root, activeId);

  if (!removed.removed) return root;

  if (overId && overId !== activeId) {
    const targetParent = findParent(removed.nodes, overId);

    if (targetParent !== undefined && targetParent === parentId) {
      const siblings =
        parentId === null
          ? removed.nodes
          : findNode(removed.nodes, parentId)?.children || [];

      const oldIndex = siblings.findIndex((item) => item.id === activeId);

      const newIndex = siblings.findIndex((item) => item.id === overId);

      if (newIndex !== -1) {
        const reordered = arrayMove(siblings, Math.max(0, oldIndex), newIndex);

        if (parentId === null) return reordered;

        return updateTree(removed.nodes, parentId, (node) => ({
          ...node,
          children: reordered,
        }));
      }
    }
  }

  return insertTree(removed.nodes, parentId, removed.removed);
}

function getAllNodeIds(nodes: BuilderNode[]): string[] {
  return nodes.flatMap((node) => [
    node.id,
    ...getAllNodeIds(node.children || []),
  ]);
}

function flattenNodes(
  nodes: BuilderNode[],
  depth = 0,
): Array<{ node: BuilderNode; depth: number }> {
  return nodes.flatMap((node) => [
    { node, depth },
    ...flattenNodes(node.children || [], depth + 1),
  ]);
}

function getResponsiveValue<T>(
  value:
    | {
        desktop?: T;
        tablet?: T;
        mobile?: T;
      }
    | undefined,
  device: BuilderDevice,
): T | undefined {
  if (!value) return undefined;

  return value[device] ?? value.desktop;
}

function getNodeText(node: BuilderNode) {
  const props = node.props;

  if (typeof props.text === "string") return props.text;
  if (typeof props.content === "string") return props.content;
  if (typeof props.title === "string") return props.title;

  return node.label;
}

function getNodeInlineStyle(
  node: BuilderNode,
  device: BuilderDevice,
): CSSProperties {
  const style: CSSProperties = {};
  const s = node.styles;

  const width = getResponsiveValue(s.width, device);
  const height = getResponsiveValue(s.height, device);
  const minHeight = getResponsiveValue(s.minHeight, device);
  const gap = getResponsiveValue(s.gap, device);
  const direction = getResponsiveValue(s.direction, device);
  const display = getResponsiveValue(s.display, device);
  const justify = getResponsiveValue(s.justifyContent, device);
  const align = getResponsiveValue(s.alignItems, device);

  if (width) style.width = width;
  if (height) style.height = height;
  if (minHeight) style.minHeight = minHeight;
  if (gap) style.gap = gap;

  const padding = getResponsiveValue(s.padding, device);
  const margin = getResponsiveValue(s.margin, device);

  if (padding && typeof padding === "object") {
    style.padding = [
      padding.top || "0",
      padding.right || "0",
      padding.bottom || "0",
      padding.left || "0",
    ].join(" ");
  }

  if (margin && typeof margin === "object") {
    style.margin = [
      margin.top || "0",
      margin.right || "0",
      margin.bottom || "0",
      margin.left || "0",
    ].join(" ");
  }

  if (s.color) style.color = s.color;

  if (s.background?.color) {
    style.backgroundColor = s.background.color;
  }

  if (s.border?.style && s.border.style !== "none") {
    style.border = `${s.border.width || "1px"} ${
      s.border.style
    } ${s.border.color || "#dbe3ed"}`;
  }

  const radius = getResponsiveValue(s.border?.radius, device);

  if (radius) style.borderRadius = radius;
  if (s.boxShadow) style.boxShadow = s.boxShadow;
  if (s.opacity !== undefined) style.opacity = s.opacity;
  if (s.zIndex !== undefined) style.zIndex = s.zIndex;
  if (s.overflow) style.overflow = s.overflow;

  if (display) style.display = display;
  if (direction) style.flexDirection = direction;
  if (justify) style.justifyContent = justify;
  if (align) style.alignItems = align;

  if (s.typography?.fontFamily) {
    style.fontFamily = s.typography.fontFamily;
  }

  const fontSize = getResponsiveValue(s.typography?.fontSize, device);

  if (fontSize) style.fontSize = fontSize;

  if (s.typography?.fontWeight) {
    style.fontWeight = s.typography.fontWeight;
  }

  if (s.typography?.lineHeight) {
    style.lineHeight = s.typography.lineHeight;
  }

  const textAlign = getResponsiveValue(s.typography?.textAlign, device);

  if (textAlign) style.textAlign = textAlign;

  return style;
}

function PreviewNode({
  node,
  device,
}: {
  node: BuilderNode;
  device: BuilderDevice;
}) {
  if (!node.enabled) return null;

  const props = node.props;
  const inlineStyle = getNodeInlineStyle(node, device);
  const children = node.children || [];

  if (LAYOUT_TYPES.has(node.type)) {
    return (
      <div
        className={
          node.type === "section"
            ? styles.previewSection
            : styles.previewContainer
        }
        style={inlineStyle}
      >
        {children.length ? (
          children.map((child) => (
            <PreviewNode key={child.id} node={child} device={device} />
          ))
        ) : (
          <span className={styles.emptyContainer}>Drop widgets here</span>
        )}
      </div>
    );
  }

  if (node.type === "heading") {
    const level = String(props.level || "h2");

    const Tag = (/^h[1-6]$/.test(level) ? level : "h2") as
      | "h1"
      | "h2"
      | "h3"
      | "h4"
      | "h5"
      | "h6";

    return (
      <h2 style={inlineStyle} data-heading-level={Tag}>
        {getNodeText(node)}
      </h2>
    );
  }

  if (node.type === "text") {
    return (
      <p className={styles.previewText} style={inlineStyle}>
        {getNodeText(node)}
      </p>
    );
  }

  if (node.type === "button") {
    return (
      <a
        href={String(props.url || "#")}
        className={styles.previewButton}
        style={inlineStyle}
      >
        {getNodeText(node)}
      </a>
    );
  }

  if (
    node.type === "image" ||
    node.type === "featured-image" ||
    node.type === "site-logo"
  ) {
    const src =
      typeof props.src === "string"
        ? props.src
        : typeof props.image === "string"
          ? props.image
          : "";

    const imageStyle: CSSProperties = {
      ...inlineStyle,
      objectFit: String(
        props.objectFit || "cover",
      ) as CSSProperties["objectFit"],
    };

    const image = src ? (
      // eslint-disable-next-line @next/next/no-img-element
      <img
        src={src}
        alt={String(props.alt || "")}
        className={styles.previewImage}
        style={imageStyle}
      />
    ) : (
      <div className={styles.imagePlaceholder}>
        <ImageIcon size={22} />
        <span>Select an image</span>
      </div>
    );

    return (
      <figure
        style={{
          margin: 0,
          textAlign: String(
            props.alignment || "left",
          ) as CSSProperties["textAlign"],
        }}
      >
        {props.link ? (
          <a
            href={String(props.link)}
            target={props.linkTarget === "_blank" ? "_blank" : undefined}
            rel="noreferrer"
          >
            {image}
          </a>
        ) : (
          image
        )}

        {props.caption ? (
          <figcaption>{String(props.caption)}</figcaption>
        ) : null}
      </figure>
    );
  }

  if (node.type === "divider") {
    return <hr className={styles.previewDivider} style={inlineStyle} />;
  }

  if (node.type === "spacer") {
    return (
      <div
        className={styles.previewSpacer}
        style={{
          ...inlineStyle,
          height: String(props.height || "40px"),
        }}
      />
    );
  }

  if (node.type === "icon") {
    return (
      <span className={styles.previewIcon} style={inlineStyle}>
        ★
      </span>
    );
  }

  if (node.type === "video") {
    return (
      <div className={styles.previewPlaceholder}>Video widget preview</div>
    );
  }

  if (node.type === "menu") {
    return (
      <nav className={styles.previewMenu}>
        <span>Home</span>
        <span>About</span>
        <span>Services</span>
        <span>Contact</span>
      </nav>
    );
  }

  if (node.type === "site-title") {
    return <strong style={inlineStyle}>{getNodeText(node)}</strong>;
  }

  if (node.type === "posts") {
    return (
      <div className={styles.previewPlaceholder}>Posts widget preview</div>
    );
  }

  if (node.type === "post-title") {
    return <h2 style={inlineStyle}>Post Title Preview</h2>;
  }

  if (node.type === "post-content") {
    return <p style={inlineStyle}>Post content will appear here.</p>;
  }

  return (
    <div className={styles.previewPlaceholder} style={inlineStyle}>
      {getNodeText(node)}
    </div>
  );
}

function PaletteWidget({
  widget,
  onAdd,
}: {
  widget: (typeof BUILDER_WIDGETS)[number];
  onAdd: () => void;
}) {
  const drag = useDraggable({
    id: `palette:${widget.type}`,
    data: {
      kind: "widget",
      widgetType: widget.type,
    },
  });

  return (
    <button
      ref={drag.setNodeRef}
      type="button"
      className={styles.widgetButton}
      style={{
        opacity: drag.isDragging ? 0.4 : 1,
        transform: CSS.Transform.toString(drag.transform),
        touchAction: "none",
      }}
      {...drag.listeners}
      {...drag.attributes}
      onClick={onAdd}
      title={widget.description}
    >
      <span className={styles.widgetIcon}>
        <LayoutGrid size={18} />
      </span>

      <span>{widget.label}</span>
    </button>
  );
}

function DropArea({
  id,
  children,
  className,
}: {
  id: string;
  children: ReactNode;
  className?: string;
}) {
  const { setNodeRef, isOver } = useDroppable({
    id: `drop:${id}`,
    data: {
      kind: "container",
      parentId: id === "root" ? null : id,
    },
  });

  return (
    <div
      ref={setNodeRef}
      className={className}
      data-over={isOver ? "true" : "false"}
      style={{
        minHeight: 28,
        outline: isOver ? "2px dashed #3984e8" : undefined,
        outlineOffset: 3,
      }}
    >
      {children}
    </div>
  );
}

function SortableCanvasNode({
  node,
  selectedId,
  device,
  onSelect,
  onDelete,
  onDuplicate,
}: {
  node: BuilderNode;
  selectedId: string | null;
  device: BuilderDevice;
  onSelect: (id: string) => void;
  onDelete: (id: string) => void;
  onDuplicate: (node: BuilderNode) => void;
}) {
  const sortable = useSortable({
    id: node.id,
    data: {
      kind: "node",
      nodeId: node.id,
    },
  });

  const selected = selectedId === node.id;
  const children = node.children || [];

  return (
    <div
      ref={sortable.setNodeRef}
      className={`${styles.canvasNode} ${
        selected ? styles.canvasNodeSelected : ""
      } ${sortable.isDragging ? styles.canvasNodeDragging : ""}`}
      style={{
        transform: CSS.Transform.toString(sortable.transform),
        transition: sortable.transition,
      }}
      onClick={(event) => {
        event.stopPropagation();
        onSelect(node.id);
      }}
    >
      <div className={styles.nodeToolbar}>
        <button
          type="button"
          className={styles.dragHandle}
          title="Drag element"
          {...sortable.attributes}
          {...sortable.listeners}
        >
          <Move size={13} />
        </button>

        <span>{node.label}</span>

        <div className={styles.nodeActions}>
          <button
            type="button"
            title="Duplicate"
            onClick={(event) => {
              event.stopPropagation();
              onDuplicate(node);
            }}
          >
            <Copy size={13} />
          </button>

          <button
            type="button"
            title="Delete"
            onClick={(event) => {
              event.stopPropagation();
              onDelete(node.id);
            }}
          >
            <Trash2 size={13} />
          </button>
        </div>
      </div>

      {LAYOUT_TYPES.has(node.type) ? (
        <div
          className={styles.nodePreview}
          style={getNodeInlineStyle(node, device)}
        >
          <DropArea id={node.id} className={styles.nestedDropArea}>
            {children.length ? (
              <SortableContext
                items={children.map((child) => child.id)}
                strategy={verticalListSortingStrategy}
              >
                <div className={styles.canvasElements}>
                  {children.map((child) => (
                    <SortableCanvasNode
                      key={child.id}
                      node={child}
                      selectedId={selectedId}
                      device={device}
                      onSelect={onSelect}
                      onDelete={onDelete}
                      onDuplicate={onDuplicate}
                    />
                  ))}
                </div>
              </SortableContext>
            ) : (
              <div className={styles.emptyContainer}>Drop elements here</div>
            )}
          </DropArea>
        </div>
      ) : (
        <div className={styles.nodePreview}>
          <PreviewNode node={node} device={device} />
        </div>
      )}
    </div>
  );
}

function NavigatorNode({
  node,
  depth,
  selectedId,
  onSelect,
  onDelete,
}: {
  node: BuilderNode;
  depth: number;
  selectedId: string | null;
  onSelect: (id: string) => void;
  onDelete: (id: string) => void;
}) {
  const [expanded, setExpanded] = useState(true);

  const sortable = useSortable({
    id: `navigator:${node.id}`,
    data: {
      kind: "node",
      nodeId: node.id,
    },
  });

  const hasChildren = Boolean(node.children?.length);

  return (
    <div
      ref={sortable.setNodeRef}
      style={{
        transform: CSS.Transform.toString(sortable.transform),
        transition: sortable.transition,
        opacity: sortable.isDragging ? 0.4 : 1,
      }}
    >
      <div
        className={
          selectedId === node.id
            ? styles.navigatorItemActive
            : styles.navigatorItem
        }
        style={{ paddingLeft: 8 + depth * 16 }}
      >
        <button
          type="button"
          title="Drag to reorder"
          {...sortable.attributes}
          {...sortable.listeners}
          style={{
            border: 0,
            background: "transparent",
            color: "inherit",
            padding: 2,
            cursor: "grab",
          }}
        >
          <Move size={12} />
        </button>

        <button
          type="button"
          onClick={() => setExpanded((value) => !value)}
          aria-label="Expand element"
          style={{
            border: 0,
            background: "transparent",
            padding: 2,
            color: "inherit",
          }}
        >
          {hasChildren ? (
            expanded ? (
              <ChevronDown size={13} />
            ) : (
              <ChevronRight size={13} />
            )
          ) : (
            <span style={{ width: 13 }} />
          )}
        </button>

        <button
          type="button"
          onClick={() => onSelect(node.id)}
          style={{
            flex: 1,
            border: 0,
            background: "transparent",
            color: "inherit",
            textAlign: "left",
            minWidth: 0,
          }}
        >
          <Layers size={13} />
          {node.label}
        </button>

        <button
          type="button"
          title="Delete"
          onClick={() => onDelete(node.id)}
          style={{
            border: 0,
            background: "transparent",
            color: "inherit",
            cursor: "pointer",
          }}
        >
          <Trash2 size={12} />
        </button>
      </div>

      {expanded &&
        node.children?.map((child) => (
          <NavigatorNode
            key={child.id}
            node={child}
            depth={depth + 1}
            selectedId={selectedId}
            onSelect={onSelect}
            onDelete={onDelete}
          />
        ))}
    </div>
  );
}

function UnitField({
  label,
  value,
  onChange,
  placeholder = "0",
  allowAuto = true,
}: {
  label: string;
  value: string;
  onChange: (value: string) => void;
  placeholder?: string;
  allowAuto?: boolean;
}) {
  const parsed = /^(-?\d*\.?\d+)(px|%|rem|em|vw|vh)$/.exec(value);
  const number = parsed?.[1] || "";
  const unit = parsed?.[2] || (value === "auto" ? "auto" : "px");

  return (
    <label className={styles.fieldLabel}>
      {label}

      <div style={{ display: "flex", gap: 5 }}>
        <input
          type="number"
          value={number}
          placeholder={placeholder}
          onChange={(event) => {
            const next = event.target.value;
            onChange(next ? `${next}${unit === "auto" ? "px" : unit}` : "");
          }}
        />

        <select
          value={unit}
          onChange={(event) => {
            const nextUnit = event.target.value;
            onChange(
              nextUnit === "auto" ? "auto" : `${number || "0"}${nextUnit}`,
            );
          }}
          style={{ maxWidth: 85 }}
        >
          {UNITS.filter((item) => allowAuto || item !== "auto").map((item) => (
            <option key={item} value={item}>
              {item}
            </option>
          ))}
        </select>
      </div>
    </label>
  );
}

export default function UniversalBuilder({ target }: Props) {
  const documentKey = useMemo(
    () => createDocumentKey(target.kind, target),
    [target],
  );

  const [layout, setLayout] = useState<BuilderLayout>(() =>
    createDefaultLayout(target.kind),
  );

  const [title, setTitle] = useState(
    target.title || `${KIND_LABELS[target.kind]} Builder`,
  );

  const [status, setStatus] = useState<"DRAFT" | "PUBLISHED" | "ARCHIVED">(
    "DRAFT",
  );

  const [settings, setSettings] = useState<Record<string, unknown>>(() =>
    createDefaultSettings(target.kind),
  );

  const [globalStyles] = useState<BuilderGlobalStyles>(DEFAULT_GLOBAL_STYLES);

  const [conditions] = useState<Record<string, unknown>>(
    createDefaultConditions(),
  );

  const [selectedId, setSelectedId] = useState<string | null>(null);

  const [device, setDevice] = useState<BuilderDevice>("desktop");

  const [activePanel, setActivePanel] = useState<
    "widgets" | "navigator" | "settings"
  >("widgets");

  const [elementTab, setElementTab] = useState<"widgets" | "globals" | "yoast">(
    "widgets",
  );

  const [inspectorTab, setInspectorTab] = useState<
    "content" | "style" | "advanced"
  >("content");

  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState("");
  const [error, setError] = useState("");

  const [widgetSearch, setWidgetSearch] = useState("");

  const [history, setHistory] = useState<HistoryState[]>([]);
  const [historyIndex, setHistoryIndex] = useState(-1);

  const [mediaPickerOpen, setMediaPickerOpen] = useState(false);
  const [mediaLoading, setMediaLoading] = useState(false);
  const [mediaItems, setMediaItems] = useState<MediaItem[]>([]);
  const [mediaSearch, setMediaSearch] = useState("");

  const sensors = useSensors(
    useSensor(PointerSensor, {
      activationConstraint: { distance: 6 },
    }),
  );

  const selectedNode = useMemo(
    () => findNode(layout.root, selectedId),
    [layout.root, selectedId],
  );

  const commitRoot = useCallback(
    (nextRoot: BuilderNode[]) => {
      setLayout({
        version: 1,
        root: nextRoot,
      });

      setHistory((current) => {
        const base = current.slice(0, historyIndex + 1);

        return [
          ...base,
          {
            root: structuredClone(nextRoot),
          },
        ];
      });

      setHistoryIndex((index) => index + 1);
    },
    [historyIndex],
  );

  const undo = () => {
    if (historyIndex <= 0) return;

    const nextIndex = historyIndex - 1;

    setHistoryIndex(nextIndex);

    setLayout({
      version: 1,
      root: structuredClone(history[nextIndex].root),
    });
  };

  const redo = () => {
    if (historyIndex >= history.length - 1) return;

    const nextIndex = historyIndex + 1;

    setHistoryIndex(nextIndex);

    setLayout({
      version: 1,
      root: structuredClone(history[nextIndex].root),
    });
  };

  const loadDocument = useCallback(async () => {
    setLoading(true);
    setError("");

    try {
      const response = await fetch(
        `/api/admin/builder/documents?documentKey=${encodeURIComponent(
          documentKey,
        )}`,
        {
          cache: "no-store",
        },
      );

      const result = (await response.json()) as DocumentResponse;

      if (!response.ok || !result.success) {
        throw new Error(result.message || "Unable to load builder.");
      }

      if (result.document) {
        const doc = result.document;

        const root =
          doc.layout?.version === 1 && Array.isArray(doc.layout.root)
            ? doc.layout.root
            : createDefaultLayout(target.kind).root;

        setLayout({
          version: 1,
          root,
        });

        setHistory([
          {
            root: structuredClone(root),
          },
        ]);

        setHistoryIndex(0);
        setTitle(doc.title);
        setStatus(doc.status);
        setSettings(doc.settings || createDefaultSettings(target.kind));
      } else {
        const root = createDefaultLayout(target.kind).root;

        setLayout({
          version: 1,
          root,
        });

        setHistory([
          {
            root: structuredClone(root),
          },
        ]);

        setHistoryIndex(0);
        setStatus("DRAFT");
      }
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Unable to load builder document.",
      );
    } finally {
      setLoading(false);
    }
  }, [documentKey, target.kind]);

  useEffect(() => {
    void loadDocument();
  }, [loadDocument]);

  const createWidget = (type: string): BuilderNode | null => {
    const definition = BUILDER_WIDGETS.find((item) => item.type === type);

    if (!definition) return null;

    return createDefaultNode(
      definition.type,
      definition.label,
      makeId(definition.type),
      {
        ...definition.defaultProps,
      },
      [],
    );
  };

  const addWidget = (type: string, parentId: string | null = null) => {
    const node = createWidget(type);

    if (!node) return;

    commitRoot(insertTree(layout.root, parentId, node));

    setSelectedId(node.id);
    setActivePanel("settings");
    setInspectorTab("content");
  };

  const deleteNode = (id: string) => {
    const result = removeTree(layout.root, id);

    if (!result.removed) return;

    commitRoot(result.nodes);

    if (selectedId === id) {
      setSelectedId(null);
    }
  };

  const duplicateNode = (node: BuilderNode) => {
    const duplicate = cloneNode(node);

    duplicate.label = `${node.label} Copy`;

    const parentId = findParent(layout.root, node.id);

    if (parentId === undefined) return;

    const source =
      parentId === null
        ? layout.root
        : findNode(layout.root, parentId)?.children || [];

    const index = source.findIndex((item) => item.id === node.id);

    if (index === -1) return;

    const next = [...source];

    next.splice(index + 1, 0, duplicate);

    const nextRoot =
      parentId === null
        ? next
        : updateTree(layout.root, parentId, (item) => ({
            ...item,
            children: next,
          }));

    commitRoot(nextRoot);
    setSelectedId(duplicate.id);
  };

  const handleDragEnd = (event: DragEndEvent) => {
    const { active, over } = event;

    if (!over) return;

    const data = active.data.current;
    const overData = over.data.current;

    if (data?.kind === "widget") {
      const type = String(data.widgetType || "");
      const node = createWidget(type);

      if (!node) return;

      let parentId: string | null = null;

      if (overData?.kind === "container") {
        parentId = (overData.parentId as string | null) ?? null;
      } else if (overData?.kind === "node") {
        const targetNode = findNode(
          layout.root,
          String(overData.nodeId || over.id),
        );

        if (targetNode && LAYOUT_TYPES.has(targetNode.type)) {
          parentId = targetNode.id;
        }
      }

      commitRoot(insertTree(layout.root, parentId, node));

      setSelectedId(node.id);
      setActivePanel("settings");
      setInspectorTab("content");

      return;
    }

    if (data?.kind === "node") {
      const activeId = String(
        data.nodeId || String(active.id).replace("navigator:", ""),
      );

      let parentId: string | null = null;
      let overId = String(over.id);

      if (overData?.kind === "container") {
        parentId = (overData.parentId as string | null) ?? null;
      } else if (overData?.kind === "node") {
        const targetId = String(overData.nodeId || over.id);

        const targetNode = findNode(layout.root, targetId);

        if (
          targetNode &&
          LAYOUT_TYPES.has(targetNode.type) &&
          targetId !== activeId
        ) {
          parentId = targetId;
          overId = "";
        } else {
          parentId = findParent(layout.root, targetId) ?? null;
          overId = targetId;
        }
      } else {
        return;
      }

      const movingNode = findNode(layout.root, activeId);

      if (!movingNode) return;

      const descendants = getAllNodeIds([movingNode]);

      if (parentId && descendants.includes(parentId)) {
        return;
      }

      if (overId === activeId) return;

      const nextRoot = moveNode(layout.root, activeId, overId, parentId);

      commitRoot(nextRoot);
    }
  };

  const updateSelectedProps = (key: string, value: unknown) => {
    if (!selectedId) return;

    commitRoot(
      updateTree(layout.root, selectedId, (node) => ({
        ...node,
        props: {
          ...node.props,
          [key]: value,
        },
      })),
    );
  };

  const updateSelectedStyle = (key: string, value: unknown) => {
    if (!selectedId) return;

    commitRoot(
      updateTree(layout.root, selectedId, (node) => ({
        ...node,
        styles: {
          ...node.styles,
          [key]: {
            ...(node.styles[key as keyof typeof node.styles] as
              | Record<string, unknown>
              | undefined),
            [device]: value,
          },
        },
      })),
    );
  };

  const updateSelectedAdvanced = (key: string, value: unknown) => {
    if (!selectedId) return;

    commitRoot(
      updateTree(layout.root, selectedId, (node) => ({
        ...node,
        advanced: {
          ...(node.advanced || {}),
          [key]: value,
        },
      })),
    );
  };

  const updateSelectedLabel = (value: string) => {
    if (!selectedId) return;

    commitRoot(
      updateTree(layout.root, selectedId, (node) => ({
        ...node,
        label: value,
      })),
    );
  };

  const updateSelectedColor = (key: "color" | "background", value: string) => {
    if (!selectedId) return;

    commitRoot(
      updateTree(layout.root, selectedId, (node) => ({
        ...node,
        styles:
          key === "color"
            ? {
                ...node.styles,
                color: value,
              }
            : {
                ...node.styles,
                background: {
                  ...node.styles.background,
                  type: "classic",
                  color: value,
                },
              },
      })),
    );
  };

  const updateSpacing = (
    key: "padding" | "margin",
    side: "top" | "right" | "bottom" | "left",
    value: string,
  ) => {
    if (!selectedId) return;

    commitRoot(
      updateTree(layout.root, selectedId, (node) => ({
        ...node,
        styles: {
          ...node.styles,
          [key]: {
            ...node.styles[key]?.[device],
            [device]: {
              ...(node.styles[key]?.[device] || {}),
              [side]: value,
            },
          },
        },
      })),
    );
  };

  const openMediaLibrary = async () => {
    setMediaPickerOpen(true);
    setMediaLoading(true);
    setMediaSearch("");
    setError("");

    try {
      const response = await fetch("/api/admin/media?view=library", {
        cache: "no-store",
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || "Media Library load nahi hui.");
      }

      const items = Array.isArray(result.media)
        ? result.media
        : Array.isArray(result.items)
          ? result.items
          : [];

      setMediaItems(items);
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Media Library load nahi hui.",
      );
    } finally {
      setMediaLoading(false);
    }
  };

  const chooseMedia = (item: MediaItem) => {
    if (!selectedId) return;

    const imageUrl = item.filePath || item.url || "";

    if (!imageUrl) {
      setError("Selected media URL available nahi hai.");
      return;
    }

    commitRoot(
      updateTree(layout.root, selectedId, (node) => ({
        ...node,
        props: {
          ...node.props,
          src: imageUrl,
          image: imageUrl,
          alt: item.altText || node.props.alt || "",
          mediaId: item.id,
        },
      })),
    );

    setMediaPickerOpen(false);
  };

  const saveDocument = async (nextStatus: "DRAFT" | "PUBLISHED") => {
    setSaving(true);
    setError("");
    setMessage("");

    try {
      const response = await fetch("/api/admin/builder/documents", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          documentKey,
          kind: target.kind,
          title,
          slug: target.slug ?? null,
          targetId: target.id ?? null,
          postTypeSlug: target.postTypeSlug ?? null,
          status: nextStatus,
          layout,
          settings,
          globalStyles,
          conditions,
        }),
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || "Unable to save builder.");
      }

      setStatus(nextStatus);
      setMessage(result.message || "Saved successfully.");
    } catch (err) {
      setError(err instanceof Error ? err.message : "Unable to save builder.");
    } finally {
      setSaving(false);
    }
  };

  const widgetGroups = useMemo(
    () =>
      BUILDER_WIDGET_CATEGORIES.map((category) => ({
        category,
        widgets: BUILDER_WIDGETS.filter(
          (widget) =>
            widget.category === category &&
            `${widget.label} ${widget.description}`
              .toLowerCase()
              .includes(widgetSearch.toLowerCase()),
        ),
      })).filter((group) => group.widgets.length > 0),
    [widgetSearch],
  );

  const filteredMedia = mediaItems.filter((item) =>
    `${item.fileName || ""} ${item.originalName || ""}`
      .toLowerCase()
      .includes(mediaSearch.toLowerCase()),
  );

  const isImageNode =
    selectedNode &&
    ["image", "site-logo", "featured-image"].includes(selectedNode.type);

  const allNodeIds = useMemo(() => getAllNodeIds(layout.root), [layout.root]);

  if (loading) {
    return (
      <div className={styles.loadingPage}>
        <Loader2 className={styles.spin} size={28} />
        Loading Builder...
      </div>
    );
  }

  return (
    <DndContext
      sensors={sensors}
      collisionDetection={(args) =>
        pointerWithin(args).length ? pointerWithin(args) : closestCenter(args)
      }
      onDragEnd={handleDragEnd}
    >
      <main className={styles.builder}>
        <header className={styles.topbar}>
          <div className={styles.topbarLeft}>
            <Link href="/admin/builder" className={styles.backButton}>
              <ArrowLeft size={17} />
            </Link>

            <div className={styles.documentInfo}>
              <input
                aria-label="Document title"
                value={title}
                onChange={(event) => setTitle(event.target.value)}
                className={styles.titleInput}
              />

              <span className={styles.documentStatus}>
                {status === "PUBLISHED" ? "Published" : "Draft"}
              </span>
            </div>
          </div>

          <div className={styles.deviceControls}>
            <button
              type="button"
              className={device === "desktop" ? styles.deviceActive : ""}
              onClick={() => setDevice("desktop")}
              title="Desktop"
            >
              <Monitor size={17} />
            </button>

            <button
              type="button"
              className={device === "tablet" ? styles.deviceActive : ""}
              onClick={() => setDevice("tablet")}
              title="Tablet"
            >
              <Tablet size={17} />
            </button>

            <button
              type="button"
              className={device === "mobile" ? styles.deviceActive : ""}
              onClick={() => setDevice("mobile")}
              title="Mobile"
            >
              <Smartphone size={17} />
            </button>
          </div>

          <div className={styles.topbarActions}>
            <button
              type="button"
              className={styles.previewButton}
              onClick={() =>
                setMessage(
                  "Canvas preview active. Frontend preview route is not connected yet.",
                )
              }
            >
              <Eye size={16} />
              Preview
            </button>

            <button
              type="button"
              className={styles.previewButton}
              onClick={undo}
              disabled={historyIndex <= 0}
              title="Undo"
            >
              <Undo2 size={16} />
            </button>

            <button
              type="button"
              className={styles.previewButton}
              onClick={redo}
              disabled={historyIndex >= history.length - 1}
              title="Redo"
            >
              <Redo2 size={16} />
            </button>

            <button
              type="button"
              className={styles.saveButton}
              onClick={() => void saveDocument("DRAFT")}
              disabled={saving}
            >
              {saving ? (
                <Loader2 size={16} className={styles.spin} />
              ) : (
                <Save size={16} />
              )}
              Save Draft
            </button>

            <button
              type="button"
              className={styles.publishButton}
              onClick={() => void saveDocument("PUBLISHED")}
              disabled={saving}
            >
              <Upload size={16} />
              Publish
            </button>
          </div>
        </header>

        {(error || message) && (
          <div
            className={error ? styles.errorBanner : styles.messageBanner}
            role={error ? "alert" : "status"}
          >
            {error || message}
          </div>
        )}

        <div className={styles.workspace}>
          <aside className={styles.leftPanel}>
            <div className={styles.panelTabs}>
              <button
                type="button"
                className={
                  activePanel === "widgets" ? styles.panelTabActive : ""
                }
                onClick={() => setActivePanel("widgets")}
              >
                <Plus size={16} />
                Elements
              </button>

              <button
                type="button"
                className={
                  activePanel === "navigator" ? styles.panelTabActive : ""
                }
                onClick={() => setActivePanel("navigator")}
              >
                <Layers size={16} />
                Navigator
              </button>

              <button
                type="button"
                className={
                  activePanel === "settings" ? styles.panelTabActive : ""
                }
                onClick={() => setActivePanel("settings")}
              >
                <Settings2 size={16} />
                Settings
              </button>
            </div>

            {activePanel === "widgets" && (
              <div className={styles.widgetPanel}>
                <div className={styles.panelHeading}>Elements</div>

                <div
                  style={{
                    display: "grid",
                    gridTemplateColumns: "repeat(3, 1fr)",
                    borderBottom: "1px solid #e2e8f0",
                    marginBottom: 14,
                  }}
                >
                  <button
                    type="button"
                    onClick={() => setElementTab("widgets")}
                    style={{
                      padding: "12px 4px",
                      border: 0,
                      borderBottom:
                        elementTab === "widgets"
                          ? "2px solid #3984e8"
                          : "2px solid transparent",
                      background: "transparent",
                      fontWeight: elementTab === "widgets" ? 700 : 400,
                    }}
                  >
                    Widgets
                  </button>

                  <button
                    type="button"
                    onClick={() => setElementTab("globals")}
                    style={{
                      padding: "12px 4px",
                      border: 0,
                      borderBottom:
                        elementTab === "globals"
                          ? "2px solid #3984e8"
                          : "2px solid transparent",
                      background: "transparent",
                      fontWeight: elementTab === "globals" ? 700 : 400,
                    }}
                  >
                    Globals
                  </button>

                  <button
                    type="button"
                    onClick={() => setElementTab("yoast")}
                    style={{
                      padding: "12px 4px",
                      border: 0,
                      borderBottom:
                        elementTab === "yoast"
                          ? "2px solid #3984e8"
                          : "2px solid transparent",
                      background: "transparent",
                      fontWeight: elementTab === "yoast" ? 700 : 400,
                    }}
                  >
                    Yoast SEO
                  </button>
                </div>

                {elementTab === "widgets" && (
                  <>
                    <div className={styles.widgetSearch}>
                      <Search size={15} />

                      <input
                        value={widgetSearch}
                        onChange={(event) =>
                          setWidgetSearch(event.target.value)
                        }
                        placeholder="Search..."
                      />
                    </div>

                    <section className={styles.widgetGroup}>
                      <h3>All</h3>

                      <div className={styles.widgetGrid}>
                        {BUILDER_WIDGETS.filter((widget) =>
                          `${widget.label} ${widget.description}`
                            .toLowerCase()
                            .includes(widgetSearch.toLowerCase()),
                        ).map((widget) => (
                          <PaletteWidget
                            key={widget.type}
                            widget={widget}
                            onAdd={() => addWidget(widget.type)}
                          />
                        ))}
                      </div>
                    </section>

                    {widgetGroups.map((group) => (
                      <section
                        className={styles.widgetGroup}
                        key={group.category}
                      >
                        <h3>{group.category}</h3>

                        <div className={styles.widgetGrid}>
                          {group.widgets.map((widget) => (
                            <PaletteWidget
                              key={`category-${widget.type}`}
                              widget={widget}
                              onAdd={() => addWidget(widget.type)}
                            />
                          ))}
                        </div>
                      </section>
                    ))}
                  </>
                )}

                {elementTab === "globals" && (
                  <div className={styles.settingsPanel}>
                    <h3>Global Settings</h3>
                    <p className={styles.mutedText}>
                      Global colors and typography are stored with this builder
                      document.
                    </p>

                    <label className={styles.fieldLabel}>
                      Global Font Family
                      <input
                        value={String(
                          settings.globalFontFamily || "Arial, sans-serif",
                        )}
                        onChange={(event) =>
                          setSettings((current) => ({
                            ...current,
                            globalFontFamily: event.target.value,
                          }))
                        }
                      />
                    </label>

                    <label className={styles.fieldLabel}>
                      Primary Color
                      <input
                        type="color"
                        value={String(settings.primaryColor || "#3984e8")}
                        onChange={(event) =>
                          setSettings((current) => ({
                            ...current,
                            primaryColor: event.target.value,
                          }))
                        }
                      />
                    </label>

                    <label className={styles.fieldLabel}>
                      Secondary Color
                      <input
                        type="color"
                        value={String(settings.secondaryColor || "#0c2f55")}
                        onChange={(event) =>
                          setSettings((current) => ({
                            ...current,
                            secondaryColor: event.target.value,
                          }))
                        }
                      />
                    </label>
                  </div>
                )}

                {elementTab === "yoast" && (
                  <div className={styles.settingsPanel}>
                    <h3>SEO Settings</h3>

                    <label className={styles.fieldLabel}>
                      SEO Title
                      <input
                        value={String(settings.seoTitle || "")}
                        onChange={(event) =>
                          setSettings((current) => ({
                            ...current,
                            seoTitle: event.target.value,
                          }))
                        }
                        placeholder="SEO title"
                      />
                    </label>

                    <label className={styles.fieldLabel}>
                      Meta Description
                      <textarea
                        rows={5}
                        value={String(settings.metaDescription || "")}
                        onChange={(event) =>
                          setSettings((current) => ({
                            ...current,
                            metaDescription: event.target.value,
                          }))
                        }
                        placeholder="Write meta description..."
                      />
                    </label>

                    <label className={styles.fieldLabel}>
                      Focus Keyphrase
                      <input
                        value={String(settings.focusKeyphrase || "")}
                        onChange={(event) =>
                          setSettings((current) => ({
                            ...current,
                            focusKeyphrase: event.target.value,
                          }))
                        }
                      />
                    </label>

                    <p className={styles.mutedText}>
                      Ye fields document settings mein save hote hain. Actual
                      Yoast integration alag se connect karni hogi.
                    </p>
                  </div>
                )}
              </div>
            )}

            {activePanel === "navigator" && (
              <div className={styles.navigatorPanel}>
                <div className={styles.panelHeading}>Navigator / Structure</div>

                {layout.root.length === 0 ? (
                  <p className={styles.mutedText}>No elements added yet.</p>
                ) : (
                  <SortableContext
                    items={layout.root.map((node) => `navigator:${node.id}`)}
                    strategy={verticalListSortingStrategy}
                  >
                    {layout.root.map((node) => (
                      <NavigatorNode
                        key={node.id}
                        node={node}
                        depth={0}
                        selectedId={selectedId}
                        onSelect={(id) => {
                          setSelectedId(id);
                          setActivePanel("settings");
                        }}
                        onDelete={deleteNode}
                      />
                    ))}
                  </SortableContext>
                )}
              </div>
            )}

            {activePanel === "settings" && (
              <div className={styles.settingsPanel}>
                <div className={styles.panelHeading}>
                  {selectedNode ? selectedNode.label : "Document Settings"}
                </div>

                {selectedNode ? (
                  <>
                    <div
                      style={{
                        display: "grid",
                        gridTemplateColumns: "repeat(3, 1fr)",
                        borderBottom: "1px solid #e2e8f0",
                        marginBottom: 16,
                      }}
                    >
                      {(["content", "style", "advanced"] as const).map(
                        (tab) => (
                          <button
                            key={tab}
                            type="button"
                            onClick={() => setInspectorTab(tab)}
                            style={{
                              padding: "12px 4px",
                              border: 0,
                              borderBottom:
                                inspectorTab === tab
                                  ? "2px solid #3984e8"
                                  : "2px solid transparent",
                              background: "transparent",
                              textTransform: "capitalize",
                              fontWeight: inspectorTab === tab ? 700 : 400,
                            }}
                          >
                            {tab}
                          </button>
                        ),
                      )}
                    </div>

                    {inspectorTab === "content" && (
                      <>
                        <h3 className={styles.inspectorSectionTitle}>
                          Content
                        </h3>

                        <label className={styles.fieldLabel}>
                          Element Name
                          <input
                            value={selectedNode.label}
                            onChange={(event) =>
                              updateSelectedLabel(event.target.value)
                            }
                          />
                        </label>

                        {(selectedNode.type === "heading" ||
                          selectedNode.type === "text" ||
                          selectedNode.type === "button" ||
                          selectedNode.type === "site-title") && (
                          <label className={styles.fieldLabel}>
                            {selectedNode.type === "text" ? "Content" : "Text"}

                            <textarea
                              rows={4}
                              value={getNodeText(selectedNode)}
                              onChange={(event) =>
                                updateSelectedProps(
                                  selectedNode.type === "text"
                                    ? "content"
                                    : "text",
                                  event.target.value,
                                )
                              }
                            />
                          </label>
                        )}

                        {selectedNode.type === "heading" && (
                          <label className={styles.fieldLabel}>
                            HTML Tag
                            <select
                              value={String(selectedNode.props.level || "h2")}
                              onChange={(event) =>
                                updateSelectedProps("level", event.target.value)
                              }
                            >
                              {["h1", "h2", "h3", "h4", "h5", "h6"].map(
                                (level) => (
                                  <option key={level} value={level}>
                                    {level.toUpperCase()}
                                  </option>
                                ),
                              )}
                            </select>
                          </label>
                        )}

                        {isImageNode && (
                          <>
                            <div className={styles.fieldLabel}>
                              Image
                              <button
                                type="button"
                                className={styles.previewButton}
                                onClick={() => void openMediaLibrary()}
                                style={{
                                  width: "100%",
                                  justifyContent: "center",
                                  marginTop: 6,
                                }}
                              >
                                <ImageIcon size={16} />
                                Choose Image from Media Library
                              </button>
                            </div>

                            <label className={styles.fieldLabel}>
                              Image URL
                              <input
                                value={String(selectedNode.props.src || "")}
                                placeholder="/uploads/media/image.png"
                                onChange={(event) =>
                                  updateSelectedProps("src", event.target.value)
                                }
                              />
                            </label>

                            <label className={styles.fieldLabel}>
                              Alt Text
                              <input
                                value={String(selectedNode.props.alt || "")}
                                onChange={(event) =>
                                  updateSelectedProps("alt", event.target.value)
                                }
                              />
                            </label>

                            <label className={styles.fieldLabel}>
                              Image Resolution
                              <select
                                value={String(
                                  selectedNode.props.resolution || "full",
                                )}
                                onChange={(event) =>
                                  updateSelectedProps(
                                    "resolution",
                                    event.target.value,
                                  )
                                }
                              >
                                <option value="thumbnail">Thumbnail</option>
                                <option value="medium">Medium</option>
                                <option value="large">Large</option>
                                <option value="full">Full</option>
                              </select>
                            </label>

                            <label className={styles.fieldLabel}>
                              Image Link
                              <input
                                value={String(selectedNode.props.link || "")}
                                placeholder="https://example.com"
                                onChange={(event) =>
                                  updateSelectedProps(
                                    "link",
                                    event.target.value,
                                  )
                                }
                              />
                            </label>

                            <label className={styles.fieldLabel}>
                              Link Target
                              <select
                                value={String(
                                  selectedNode.props.linkTarget || "_self",
                                )}
                                onChange={(event) =>
                                  updateSelectedProps(
                                    "linkTarget",
                                    event.target.value,
                                  )
                                }
                              >
                                <option value="_self">Same Window</option>
                                <option value="_blank">New Window</option>
                              </select>
                            </label>

                            <label className={styles.fieldLabel}>
                              Caption
                              <input
                                value={String(selectedNode.props.caption || "")}
                                onChange={(event) =>
                                  updateSelectedProps(
                                    "caption",
                                    event.target.value,
                                  )
                                }
                              />
                            </label>

                            <label className={styles.fieldLabel}>
                              Dynamic Link
                              <select
                                value={String(
                                  selectedNode.props.dynamicLink || "",
                                )}
                                onChange={(event) =>
                                  updateSelectedProps(
                                    "dynamicLink",
                                    event.target.value,
                                  )
                                }
                              >
                                <option value="">None</option>
                                <option value="post-url">Post URL</option>
                                <option value="site-url">Site URL</option>
                                <option value="author-url">Author URL</option>
                              </select>
                            </label>
                          </>
                        )}

                        {selectedNode.type === "button" && (
                          <label className={styles.fieldLabel}>
                            Button URL
                            <input
                              value={String(selectedNode.props.url || "#")}
                              onChange={(event) =>
                                updateSelectedProps("url", event.target.value)
                              }
                            />
                          </label>
                        )}
                      </>
                    )}

                    {inspectorTab === "style" && (
                      <>
                        <h3 className={styles.inspectorSectionTitle}>Style</h3>

                        {isImageNode && (
                          <>
                            <label className={styles.fieldLabel}>
                              Alignment
                              <select
                                value={String(
                                  selectedNode.props.alignment || "left",
                                )}
                                onChange={(event) =>
                                  updateSelectedProps(
                                    "alignment",
                                    event.target.value,
                                  )
                                }
                              >
                                <option value="left">Left</option>
                                <option value="center">Center</option>
                                <option value="right">Right</option>
                                <option value="justify">Justify</option>
                              </select>
                            </label>

                            <label className={styles.fieldLabel}>
                              Object Fit
                              <select
                                value={String(
                                  selectedNode.props.objectFit || "cover",
                                )}
                                onChange={(event) =>
                                  updateSelectedProps(
                                    "objectFit",
                                    event.target.value,
                                  )
                                }
                              >
                                <option value="cover">Cover</option>
                                <option value="contain">Contain</option>
                                <option value="fill">Fill</option>
                                <option value="none">None</option>
                              </select>
                            </label>
                          </>
                        )}

                        <UnitField
                          label="Width"
                          value={String(
                            getResponsiveValue(
                              selectedNode.styles.width,
                              device,
                            ) || "",
                          )}
                          onChange={(value) =>
                            updateSelectedStyle("width", value)
                          }
                          placeholder="100"
                        />

                        <UnitField
                          label="Height"
                          value={String(
                            getResponsiveValue(
                              selectedNode.styles.height,
                              device,
                            ) || "",
                          )}
                          onChange={(value) =>
                            updateSelectedStyle("height", value)
                          }
                          placeholder="auto"
                        />

                        <label className={styles.fieldLabel}>
                          Text / Foreground Color
                          <input
                            type="color"
                            value={selectedNode.styles.color || "#334155"}
                            onChange={(event) =>
                              updateSelectedColor("color", event.target.value)
                            }
                          />
                        </label>

                        <label className={styles.fieldLabel}>
                          Background Color
                          <input
                            type="color"
                            value={
                              selectedNode.styles.background?.color || "#ffffff"
                            }
                            onChange={(event) =>
                              updateSelectedColor(
                                "background",
                                event.target.value,
                              )
                            }
                          />
                        </label>

                        <label className={styles.fieldLabel}>
                          Border Style
                          <select
                            value={String(
                              selectedNode.styles.border?.style || "none",
                            )}
                            onChange={(event) =>
                              commitRoot(
                                updateTree(
                                  layout.root,
                                  selectedNode.id,
                                  (node) => ({
                                    ...node,
                                    styles: {
                                      ...node.styles,
                                      border: {
                                        ...node.styles.border,
                                        style: event.target
                                          .value as NonNullable<
                                          BuilderNode["styles"]["border"]
                                        >["style"],
                                      },
                                    },
                                  }),
                                ),
                              )
                            }
                          >
                            <option value="none">None</option>
                            <option value="solid">Solid</option>
                            <option value="dashed">Dashed</option>
                            <option value="dotted">Dotted</option>
                            <option value="double">Double</option>
                          </select>
                        </label>

                        <label className={styles.fieldLabel}>
                          Border Width
                          <input
                            value={String(
                              selectedNode.styles.border?.width || "1px",
                            )}
                            onChange={(event) =>
                              commitRoot(
                                updateTree(
                                  layout.root,
                                  selectedNode.id,
                                  (node) => ({
                                    ...node,
                                    styles: {
                                      ...node.styles,
                                      border: {
                                        ...node.styles.border,
                                        width: event.target.value,
                                      },
                                    },
                                  }),
                                ),
                              )
                            }
                          />
                        </label>

                        <label className={styles.fieldLabel}>
                          Border Color
                          <input
                            type="color"
                            value={
                              selectedNode.styles.border?.color || "#dbe3ed"
                            }
                            onChange={(event) =>
                              commitRoot(
                                updateTree(
                                  layout.root,
                                  selectedNode.id,
                                  (node) => ({
                                    ...node,
                                    styles: {
                                      ...node.styles,
                                      border: {
                                        ...node.styles.border,
                                        color: event.target.value,
                                      },
                                    },
                                  }),
                                ),
                              )
                            }
                          />
                        </label>

                        <label className={styles.fieldLabel}>
                          Border Radius
                          <input
                            value={String(
                              selectedNode.styles.border?.radius?.[device] ||
                                "",
                            )}
                            placeholder="8px"
                            onChange={(event) =>
                              commitRoot(
                                updateTree(
                                  layout.root,
                                  selectedNode.id,
                                  (node) => ({
                                    ...node,
                                    styles: {
                                      ...node.styles,
                                      border: {
                                        ...node.styles.border,
                                        radius: {
                                          ...node.styles.border?.radius,
                                          [device]: event.target.value,
                                        },
                                      },
                                    },
                                  }),
                                ),
                              )
                            }
                          />
                        </label>

                        <label className={styles.fieldLabel}>
                          Opacity
                          <input
                            type="range"
                            min="0"
                            max="1"
                            step="0.05"
                            value={String(selectedNode.styles.opacity ?? 1)}
                            onChange={(event) =>
                              commitRoot(
                                updateTree(
                                  layout.root,
                                  selectedNode.id,
                                  (node) => ({
                                    ...node,
                                    styles: {
                                      ...node.styles,
                                      opacity: Number(event.target.value),
                                    },
                                  }),
                                ),
                              )
                            }
                          />
                        </label>

                        <label className={styles.fieldLabel}>
                          Font Size
                          <input
                            value={String(
                              selectedNode.styles.typography?.fontSize?.[
                                device
                              ] || "",
                            )}
                            placeholder="16px"
                            onChange={(event) =>
                              commitRoot(
                                updateTree(
                                  layout.root,
                                  selectedNode.id,
                                  (node) => ({
                                    ...node,
                                    styles: {
                                      ...node.styles,
                                      typography: {
                                        ...node.styles.typography,
                                        fontSize: {
                                          ...node.styles.typography?.fontSize,
                                          [device]: event.target.value,
                                        },
                                      },
                                    },
                                  }),
                                ),
                              )
                            }
                          />
                        </label>

                        <label className={styles.fieldLabel}>
                          Font Family
                          <input
                            value={String(
                              selectedNode.styles.typography?.fontFamily || "",
                            )}
                            placeholder="Arial, sans-serif"
                            onChange={(event) =>
                              commitRoot(
                                updateTree(
                                  layout.root,
                                  selectedNode.id,
                                  (node) => ({
                                    ...node,
                                    styles: {
                                      ...node.styles,
                                      typography: {
                                        ...node.styles.typography,
                                        fontFamily: event.target.value,
                                      },
                                    },
                                  }),
                                ),
                              )
                            }
                          />
                        </label>

                        <label className={styles.fieldLabel}>
                          Text Alignment
                          <select
                            value={String(
                              selectedNode.styles.typography?.textAlign?.[
                                device
                              ] || "left",
                            )}
                            onChange={(event) =>
                              commitRoot(
                                updateTree(
                                  layout.root,
                                  selectedNode.id,
                                  (node) => ({
                                    ...node,
                                    styles: {
                                      ...node.styles,
                                      typography: {
                                        ...node.styles.typography,
                                        textAlign: {
                                          ...node.styles.typography?.textAlign,
                                          [device]: event.target.value,
                                        },
                                      },
                                    },
                                  }),
                                ),
                              )
                            }
                          >
                            <option value="left">Left</option>
                            <option value="center">Center</option>
                            <option value="right">Right</option>
                            <option value="justify">Justify</option>
                          </select>
                        </label>
                      </>
                    )}

                    {inspectorTab === "advanced" && (
                      <>
                        <h3 className={styles.inspectorSectionTitle}>
                          Advanced
                        </h3>

                        <h4>Margin</h4>

                        {(["top", "right", "bottom", "left"] as const).map(
                          (side) => (
                            <UnitField
                              key={`margin-${side}`}
                              label={`Margin ${side}`}
                              value={String(
                                selectedNode.styles.margin?.[device]?.[side] ||
                                  "",
                              )}
                              onChange={(value) =>
                                updateSpacing("margin", side, value)
                              }
                            />
                          ),
                        )}

                        <div className={styles.inspectorDivider} />

                        <h4>Padding</h4>

                        {(["top", "right", "bottom", "left"] as const).map(
                          (side) => (
                            <UnitField
                              key={`padding-${side}`}
                              label={`Padding ${side}`}
                              value={String(
                                selectedNode.styles.padding?.[device]?.[side] ||
                                  "",
                              )}
                              onChange={(value) =>
                                updateSpacing("padding", side, value)
                              }
                            />
                          ),
                        )}

                        <div className={styles.inspectorDivider} />

                        <UnitField
                          label="Advanced Width"
                          value={String(
                            selectedNode.styles.width?.[device] || "",
                          )}
                          onChange={(value) =>
                            updateSelectedStyle("width", value)
                          }
                        />

                        <UnitField
                          label="Advanced Height"
                          value={String(
                            selectedNode.styles.height?.[device] || "",
                          )}
                          onChange={(value) =>
                            updateSelectedStyle("height", value)
                          }
                        />

                        <label className={styles.fieldLabel}>
                          Align Self
                          <select
                            value={String(
                              selectedNode.styles.alignSelf || "auto",
                            )}
                            onChange={(event) =>
                              commitRoot(
                                updateTree(
                                  layout.root,
                                  selectedNode.id,
                                  (node) => ({
                                    ...node,
                                    styles: {
                                      ...node.styles,
                                      alignSelf: {
                                        ...node.styles.alignSelf,
                                        [device]: event.target.value as
                                          | "auto"
                                          | "flex-start"
                                          | "flex-end"
                                          | "center"
                                          | "stretch"
                                          | "baseline",
                                      },
                                    },
                                  }),
                                ),
                              )
                            }
                          >
                            <option value="auto">Auto</option>
                            <option value="flex-start">Start</option>
                            <option value="center">Center</option>
                            <option value="flex-end">End</option>
                            <option value="stretch">Stretch</option>
                          </select>
                        </label>

                        <label className={styles.fieldLabel}>
                          Position
                          <select
                            value={String(
                              selectedNode.styles.position || "default",
                            )}
                            onChange={(event) =>
                              commitRoot(
                                updateTree(
                                  layout.root,
                                  selectedNode.id,
                                  (node) => ({
                                    ...node,
                                    styles: {
                                      ...node.styles,
                                      position: event.target
                                        .value as BuilderNode["styles"]["position"],
                                    },
                                  }),
                                ),
                              )
                            }
                          >
                            <option value="default">Default</option>
                            <option value="relative">Relative</option>
                            <option value="absolute">Absolute</option>
                            <option value="fixed">Fixed</option>
                            <option value="sticky">Sticky</option>
                          </select>
                        </label>

                        <label className={styles.fieldLabel}>
                          Z-Index
                          <input
                            type="number"
                            value={String(selectedNode.styles.zIndex ?? "")}
                            onChange={(event) =>
                              commitRoot(
                                updateTree(
                                  layout.root,
                                  selectedNode.id,
                                  (node) => ({
                                    ...node,
                                    styles: {
                                      ...node.styles,
                                      zIndex: event.target.value
                                        ? Number(event.target.value)
                                        : undefined,
                                    },
                                  }),
                                ),
                              )
                            }
                          />
                        </label>

                        <label className={styles.fieldLabel}>
                          CSS Class
                          <input
                            value={String(selectedNode.props.cssClass || "")}
                            onChange={(event) =>
                              updateSelectedProps(
                                "cssClass",
                                event.target.value,
                              )
                            }
                          />
                        </label>

                        <label className={styles.fieldLabel}>
                          HTML ID
                          <input
                            value={String(selectedNode.props.htmlId || "")}
                            onChange={(event) =>
                              updateSelectedProps("htmlId", event.target.value)
                            }
                          />
                        </label>

                        <div className={styles.inspectorDivider} />

                        <h4>Hover Settings</h4>

                        <label className={styles.fieldLabel}>
                          Hover Background
                          <input
                            type="color"
                            value={String(
                              selectedNode.props.hoverBackground || "#ffffff",
                            )}
                            onChange={(event) =>
                              updateSelectedProps(
                                "hoverBackground",
                                event.target.value,
                              )
                            }
                          />
                        </label>

                        <label className={styles.fieldLabel}>
                          Hover Border Color
                          <input
                            type="color"
                            value={String(
                              selectedNode.props.hoverBorderColor || "#3984e8",
                            )}
                            onChange={(event) =>
                              updateSelectedProps(
                                "hoverBorderColor",
                                event.target.value,
                              )
                            }
                          />
                        </label>

                        <label className={styles.fieldLabel}>
                          Hide on Desktop
                          <input
                            type="checkbox"
                            checked={Boolean(selectedNode.props.hideDesktop)}
                            onChange={(event) =>
                              updateSelectedProps(
                                "hideDesktop",
                                event.target.checked,
                              )
                            }
                          />
                        </label>

                        <label className={styles.fieldLabel}>
                          Hide on Tablet
                          <input
                            type="checkbox"
                            checked={Boolean(selectedNode.props.hideTablet)}
                            onChange={(event) =>
                              updateSelectedProps(
                                "hideTablet",
                                event.target.checked,
                              )
                            }
                          />
                        </label>

                        <label className={styles.fieldLabel}>
                          Hide on Mobile
                          <input
                            type="checkbox"
                            checked={Boolean(selectedNode.props.hideMobile)}
                            onChange={(event) =>
                              updateSelectedProps(
                                "hideMobile",
                                event.target.checked,
                              )
                            }
                          />
                        </label>
                      </>
                    )}

                    <button
                      type="button"
                      className={styles.deleteSelected}
                      onClick={() => deleteNode(selectedNode.id)}
                    >
                      <Trash2 size={15} />
                      Delete Element
                    </button>
                  </>
                ) : (
                  <>
                    <label className={styles.fieldLabel}>
                      Document Title
                      <input
                        value={title}
                        onChange={(event) => setTitle(event.target.value)}
                      />
                    </label>

                    <label className={styles.fieldLabel}>
                      Content Width
                      <select
                        value={String(settings.contentWidth || "boxed")}
                        onChange={(event) =>
                          setSettings((current) => ({
                            ...current,
                            contentWidth: event.target.value,
                          }))
                        }
                      >
                        <option value="boxed">Boxed</option>
                        <option value="full">Full Width</option>
                      </select>
                    </label>

                    <label className={styles.fieldLabel}>
                      Container Width
                      <input
                        value={String(settings.containerWidth || "1200px")}
                        onChange={(event) =>
                          setSettings((current) => ({
                            ...current,
                            containerWidth: event.target.value,
                          }))
                        }
                      />
                    </label>
                  </>
                )}
              </div>
            )}
          </aside>

          <section className={styles.canvasArea}>
            <div className={styles.canvasTopbar}>
              <span>{KIND_LABELS[target.kind]} Editor</span>

              <span className={styles.canvasHint}>
                Drag widgets, sections and containers into canvas
              </span>
            </div>

            <div className={styles.canvasScroll}>
              <div
                className={`${styles.canvas} ${
                  device === "tablet"
                    ? styles.canvasTablet
                    : device === "mobile"
                      ? styles.canvasMobile
                      : ""
                }`}
              >
                <DropArea id="root" className={styles.canvasElements}>
                  {layout.root.length === 0 ? (
                    <div className={styles.emptyCanvas}>
                      <div className={styles.emptyCanvasIcon}>
                        <Plus size={25} />
                      </div>

                      <h2>Start building your {target.kind}</h2>

                      <p>Drag Section, Container or any widget here.</p>

                      <button
                        type="button"
                        onClick={() => {
                          setActivePanel("widgets");
                          setElementTab("widgets");
                        }}
                      >
                        Add Your First Element
                      </button>
                    </div>
                  ) : (
                    <SortableContext
                      items={layout.root.map((node) => node.id)}
                      strategy={verticalListSortingStrategy}
                    >
                      {layout.root.map((node) => (
                        <SortableCanvasNode
                          key={node.id}
                          node={node}
                          selectedId={selectedId}
                          device={device}
                          onSelect={(id) => {
                            setSelectedId(id);
                            setActivePanel("settings");
                          }}
                          onDelete={deleteNode}
                          onDuplicate={duplicateNode}
                        />
                      ))}
                    </SortableContext>
                  )}
                </DropArea>
              </div>
            </div>
          </section>
        </div>

        {mediaPickerOpen && (
          <div
            role="dialog"
            aria-modal="true"
            aria-label="Media Library"
            style={{
              position: "fixed",
              inset: 0,
              zIndex: 99999,
              background: "rgba(15,23,42,.65)",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              padding: 20,
            }}
          >
            <div
              style={{
                width: "min(1000px, 96vw)",
                height: "min(720px, 90vh)",
                background: "#fff",
                borderRadius: 10,
                display: "flex",
                flexDirection: "column",
                overflow: "hidden",
                boxShadow: "0 20px 70px rgba(0,0,0,.25)",
              }}
            >
              <div
                style={{
                  padding: 18,
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  borderBottom: "1px solid #e2e8f0",
                }}
              >
                <div>
                  <strong>Media Library</strong>
                  <div style={{ fontSize: 12, color: "#64748b" }}>
                    Select an image for this element
                  </div>
                </div>

                <button
                  type="button"
                  onClick={() => setMediaPickerOpen(false)}
                  aria-label="Close Media Library"
                  style={{
                    border: 0,
                    background: "transparent",
                    cursor: "pointer",
                  }}
                >
                  <X size={20} />
                </button>
              </div>

              <div
                style={{
                  padding: 14,
                  borderBottom: "1px solid #e2e8f0",
                }}
              >
                <div className={styles.widgetSearch}>
                  <Search size={15} />

                  <input
                    value={mediaSearch}
                    onChange={(event) => setMediaSearch(event.target.value)}
                    placeholder="Search media..."
                  />
                </div>
              </div>

              <div
                style={{
                  flex: 1,
                  overflow: "auto",
                  padding: 16,
                }}
              >
                {mediaLoading ? (
                  <div
                    style={{
                      display: "flex",
                      justifyContent: "center",
                      padding: 50,
                    }}
                  >
                    <Loader2 className={styles.spin} size={28} />
                  </div>
                ) : filteredMedia.length === 0 ? (
                  <div
                    style={{
                      textAlign: "center",
                      padding: 50,
                      color: "#64748b",
                    }}
                  >
                    No media found.
                  </div>
                ) : (
                  <div
                    style={{
                      display: "grid",
                      gridTemplateColumns:
                        "repeat(auto-fill,minmax(145px,1fr))",
                      gap: 14,
                    }}
                  >
                    {filteredMedia.map((item) => {
                      const url = item.filePath || item.url || "";

                      return (
                        <button
                          type="button"
                          key={item.id}
                          onClick={() => chooseMedia(item)}
                          style={{
                            border: "1px solid #e2e8f0",
                            borderRadius: 7,
                            padding: 8,
                            background: "#fff",
                            cursor: "pointer",
                            textAlign: "left",
                          }}
                        >
                          <div
                            style={{
                              height: 115,
                              display: "flex",
                              alignItems: "center",
                              justifyContent: "center",
                              background: "#f1f5f9",
                              borderRadius: 5,
                              overflow: "hidden",
                            }}
                          >
                            {url && item.mimeType?.startsWith("image/") ? (
                              // eslint-disable-next-line @next/next/no-img-element
                              <img
                                src={url}
                                alt={item.altText || ""}
                                style={{
                                  width: "100%",
                                  height: "100%",
                                  objectFit: "contain",
                                }}
                              />
                            ) : (
                              <ImageIcon size={30} />
                            )}
                          </div>

                          <div
                            style={{
                              fontSize: 12,
                              marginTop: 8,
                              overflow: "hidden",
                              textOverflow: "ellipsis",
                              whiteSpace: "nowrap",
                            }}
                          >
                            {item.originalName || item.fileName || item.id}
                          </div>
                        </button>
                      );
                    })}
                  </div>
                )}
              </div>

              <div
                style={{
                  padding: 14,
                  borderTop: "1px solid #e2e8f0",
                  display: "flex",
                  justifyContent: "flex-end",
                }}
              >
                <button
                  type="button"
                  onClick={() => setMediaPickerOpen(false)}
                  className={styles.previewButton}
                >
                  Cancel
                </button>
              </div>
            </div>
          </div>
        )}
      </main>
    </DndContext>
  );
}
