{
  "name": "connectbroadband-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate --schema=prisma/schema.prisma && next dev",
    "build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "db:generate:mysql": "prisma generate --schema=prisma/schema.prisma",
    "db:generate:postgres": "prisma generate --schema=prisma/postgres/schema.prisma",
    "db:validate:mysql": "prisma validate --schema=prisma/schema.prisma",
    "db:validate:postgres": "prisma validate --schema=prisma/postgres/schema.prisma"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.0",
    "@tinymce/tinymce-react": "^6.3.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "tinymce": "^8.10.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^6.19.0",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "prisma@6.19.0": true,
    "@prisma/engines@6.19.0": true
  }
}
